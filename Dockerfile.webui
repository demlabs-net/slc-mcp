# syntax=docker/dockerfile:1
# SLC Web UI — Svelte SPA + Rust REST-прокси (slc-webui), Debian 13 (trixie).

# ── фронтенд: Svelte SPA ──────────────────────────────────────────────────
FROM node:22-alpine AS frontend
WORKDIR /app/web-ui
COPY web-ui/package.json web-ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web-ui/ ./
RUN npm run build

# ── builder: Rust ──────────────────────────────────────────────────────────
FROM rust:1.97-slim-trixie AS builder
WORKDIR /build
COPY Cargo.toml ./
COPY crates/slc-core/Cargo.toml crates/slc-core/
COPY crates/slc-mcp/Cargo.toml crates/slc-mcp/
COPY crates/slc-webui/Cargo.toml crates/slc-webui/
RUN mkdir -p crates/slc-core/src crates/slc-mcp/src crates/slc-webui/src \
 && touch crates/slc-core/src/lib.rs crates/slc-mcp/src/main.rs crates/slc-webui/src/main.rs \
 && cargo fetch
COPY crates/ crates/
RUN cargo build --release -p slc-webui

# ── runtime ────────────────────────────────────────────────────────────────
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 1000 --create-home slc \
 && mkdir -p /app/dist \
 && chown -R slc:slc /app

COPY --from=builder /build/target/release/slc-webui /usr/local/bin/slc-webui
COPY --from=frontend /app/web-ui/dist /app/dist

USER slc
ENV SLC_WEBUI_DIST=/app/dist
EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3002/api/health || exit 1

ENTRYPOINT ["slc-webui"]
