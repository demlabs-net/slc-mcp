# /etc/sales-1-task-stop/env — root-only (0600). Secrets are never shown to agents.
SLC_URL=http://127.0.0.1:3000
# Must equal SLC_OPERATOR_STOP_TOKEN in /etc/slc-mcp/.env (>= 32 chars).
SLC_OPERATOR_STOP_TOKEN=
SWARM_MANAGER_MCP_URL=http://127.0.0.1:3004/roles/manager/mcp
# Same value as MANAGER_SWARM_MCP_TOKEN in /etc/swarm-mcp/.env (used only to
# wake the next FIFO head after a stop).
MANAGER_SWARM_MCP_TOKEN=
SWARM_MANAGER_ROLE=manager
# role=container:api_port for every executor whose running tasks may be stopped.
# The role list must equal SLC_STOPPABLE_PRINCIPALS in /etc/slc-mcp/.env.
SALES_1_STOP_ROLES=
SALES_1_STOP_TIMEOUT=60
SALES_1_HEALTH_TIMEOUT=180
# Optional (defaults shown). The controller id is the claim owner in SLC; keep
# it fixed so a restarted controller resumes its own claims.
# SALES_1_STOP_CONTROLLER_ID=sales-1-task-stop
# Pause between the verified stop and releasing the lane, so requests the
# killed run already sent (FaraCRM MCP times out after 30 s) can land.
# SALES_1_SETTLE_SECONDS=35
# At most one container restart per this many seconds, per container.
# SALES_1_MIN_RESTART_INTERVAL=300
