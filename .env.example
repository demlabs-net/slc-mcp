# SLC MCP — local settings (copy to .env; .env is gitignored)

# ── LLM provider ──────────────────────────────────────────────────────────
# LM Studio (OpenAI-compatible) is preferred when LMSTUDIO_URL is set;
# otherwise the Ollama endpoint is used.
LMSTUDIO_URL=http://localhost:1234
# Agentic/reasoning model — compression, consolidation, later subagent
# search. User-approved default:
LMSTUDIO_MODEL=google/gemma-4-e4b
# Embedding model — semantic search + fact dedup. User-approved default:
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Ollama fallback (used only when LMSTUDIO_URL is unset):
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_REASONING_MODEL=gemma3:latest
# OLLAMA_EMBEDDING_MODEL=bge-m3

# ── storage ───────────────────────────────────────────────────────────────
# DEFAULT backend is the Obsidian vault:
SLC_VAULT_PATH=~/.slc/vault
# Commit vault changes to git after every write (vault must be a repo):
# OBSIDIAN_AUTO_GIT_COMMIT=true
# OBSIDIAN_GIT_AUTHOR="slc-mcp <slc-mcp@local>"

# SQLite alternative:
#   slc-mcp --sqlite …  (path via SLC_VAULT_PATH, or :memory:)

# ── seats ─────────────────────────────────────────────────────────────────
# SLC_SEAT_TTL_SECONDS=86400
