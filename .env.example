# SLC MCP — настройки развертывания (копия для deploy: cp .env.example .env;
# .env не коммитится). Используется и контейнером (env_file), и CLI.

# ── Inference ─────────────────────────────────────────────────────────────
# Production serve uses MCP sampling: reasoning requests are returned to the
# authenticated seat's connected MCP client as sampling/createMessage.  SLC
# therefore needs no dedicated generative endpoint or model.  Search remains
# available through BM25 and the agent can perform iterative/agentic retrieval
# by calling the search/read tools repeatedly.
SLC_MCP_SAMPLING=true
# Fail closed to the deterministic local hash provider for CLI commands that
# run without an MCP client (for example, a non-AI migration).
SLC_LLM=hash

# Optional dedicated providers for standalone deployments.  Do not enable
# these together with SLC_MCP_SAMPLING in the development swarm.
# LMSTUDIO_URL=http://host.docker.internal:1234
# LMSTUDIO_MODEL=<reasoning-model-id>
# LMSTUDIO_EMBED_MODEL=<embedding-model-id>
# OLLAMA_ENDPOINT=http://host.docker.internal:11434
# OLLAMA_REASONING_MODEL=gemma3:latest
# OLLAMA_EMBEDDING_MODEL=bge-m3

# ── storage (Obsidian vault — DEFAULT) ────────────────────────────────────
# Путь vault на хосте (для CLI; в контейнере docker-compose.yml принудительно
# ставит /data/vault — том из этой папки).
SLC_VAULT_PATH=~/Obsidian/slc-vault
# Host bind path used by Docker Compose.
SLC_VAULT_HOST_PATH=~/Obsidian/slc-vault
# Коммитить vault в git после каждой записи (vault должен быть репозиторием;
# deploy.sh up делает git init автоматически):
OBSIDIAN_AUTO_GIT_COMMIT=true
# OBSIDIAN_GIT_AUTHOR="slc-mcp <slc-mcp@local>"
# Read-only known_hosts mounts cannot be rewritten by OpenSSH. This also
# guarantees that only the dedicated Forgejo deploy key is offered.
GIT_SSH_COMMAND=ssh -o UpdateHostKeys=no -o IdentitiesOnly=yes

# ── auth и сиды ───────────────────────────────────────────────────────────
# legacy_seat_id (как в легаси) | bearer_plus_seat | embedded — авторизация
# MCP-эндпоинтов (/mcp, /sse, /messages)
SLC_MCP_AUTH=legacy_seat_id
# 0 = сиды не протухают (импортированные легаси-сиды не теряются)
SLC_SEAT_TTL_SECONDS=0

# ── авторизация веб-морды (полный порт легаси) ───────────────────────────
# seat (default) | full — full включает users/пароли + JWT + Yandex OAuth
# для /api/*; сид выводится из пользователя (user_<id>).
# SLC_AUTH=full
# JWT: secret ОБЯЗАТЕЛЬНО сменить в production (HS256; access 30м, refresh 7д)
# JWT_SECRET_KEY=change-me-in-production
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# true = регистрация только для admins (как легаси AUTH_ENABLED)
# AUTH_ENABLED=false
#
# Yandex OAuth (кнопка «Войти через Яндекс» на Login):
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# Allowlist env-фолбэк (если нет правил oauth_access_rules в Admin):
# YANDEX_ALLOWED_USERS=
# YANDEX_ALLOWED_GROUPS=
# YANDEX_ORG_ID=
# Yandex 360 Directory (правила ya360_org / ya360_group):
# YANDEX_360_ADMIN_TOKEN=
# YANDEX_360_ORG_ID=

# ── роли сидов ─────────────────────────────────────────────────────────────
# seat=role через запятую. Роль operator разрешает использовать cross-seat
# операции, но сама по себе не даёт ни одной цели.
# SLC_SEAT_ROLES=boss=operator,planner=operator
# actor=target_a|target_b через запятую; `*` — осознанное глобальное право.
# Только комбинация operator + явная цель позволяет активировать/деактивировать
# документы, задачи, проекты и фокусы ДРУГИХ сидов (target_seat в MCP-тулах
# activate_task/activate_document/deactivate_document/deactivate_task,
# project_set_status, focus_set_archived).
# SLC_SEAT_MANAGE_ACL=boss=developer|designer,planner=developer

# Миграция сохраняет legacy id по умолчанию. AI rename включать только
# осознанно: он меняет внешние document/task/project identifiers.
SLC_MIGRATE_RENAME_WITH_AI=false

# ── организация документов ────────────────────────────────────────────────
# При add_document reasoning-LLM определяет, к какому существующему проекту
# относится документ → docs/projects/<p>/<категория>/ (иначе docs/<категория>).
# false/0 — отключает (документы всегда в категорийных папках).
SLC_AI_ORGANIZE=true

# ── контекст ──────────────────────────────────────────────────────────────
# Дефолтный бюджет update_context (ТОКЕНЫ; ~3 символа на токен).
# Это не кап: клиенты задают свой лимит через
# X-SLC-Context-Token-Limit или команду /limit N для seat.
SLC_CONTEXT_LIMIT_TOKENS=100000

# ── пагинация MCP-ответов ────────────────────────────────────────────────
# Включает серверную пагинацию больших list-shaped JSON-ответов. Размер
# страницы и порог включения задаются одним значением в приблизительных
# токенах. Клиент может переопределить оба параметра только для своего
# соединения заголовками X-SLC-Pagination и X-SLC-Page-Token-Limit.
SLC_PAGINATION_ENABLED=true
SLC_PAGE_TOKEN_LIMIT=50000

# ── Mongo (только для бэкенда --mongodb; при Obsidian-хранилище не нужен) ─
# SLC_MONGODB_URI=mongodb://localhost:27017/slc_mcp
