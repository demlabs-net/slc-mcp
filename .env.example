# SLC MCP — настройки развертывания (копия для deploy: cp .env.example .env;
# .env не коммитится). Используется и контейнером (env_file), и CLI.

# ── LLM provider ──────────────────────────────────────────────────────────
# LM Studio запущен на хосте — из контейнера доступен через
# host.docker.internal (см. extra_hosts в docker-compose.yml).
LMSTUDIO_URL=http://host.docker.internal:1234
# Agentic/reasoning модель — compress/consolidate, AI-переименование id при
# миграции (slc-mcp migrate --rename-with-ai).
LMSTUDIO_MODEL=nvidia/nemotron-3-nano-4b
# Эмбеддинг-модель — семантический поиск.
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5@f32

# Ollama fallback (используется только когда LMSTUDIO_URL не задан):
# OLLAMA_ENDPOINT=http://host.docker.internal:11434
# OLLAMA_REASONING_MODEL=gemma3:latest
# OLLAMA_EMBEDDING_MODEL=bge-m3

# ── storage (Obsidian vault — DEFAULT) ────────────────────────────────────
# Путь vault на хосте (для CLI; в контейнере docker-compose.yml принудительно
# ставит /data/vault — том из этой папки).
SLC_VAULT_PATH=~/Obsidian/slc-vault
# Коммитить vault в git после каждой записи (vault должен быть репозиторием;
# deploy.sh up делает git init автоматически):
OBSIDIAN_AUTO_GIT_COMMIT=true
# OBSIDIAN_GIT_AUTHOR="slc-mcp <slc-mcp@local>"

# ── auth и сиды ───────────────────────────────────────────────────────────
# legacy_seat_id (как в легаси) | bearer_plus_seat | embedded — авторизация
# MCP-эндпоинтов (/mcp, /sse, /messages)
SLC_MCP_AUTH=legacy_seat_id
# 0 = сиды не протухают (импортированные легаси-сиды не теряются)
SLC_SEAT_TTL_SECONDS=0

# ── авторизация веб-морды (полный порт легаси) ───────────────────────────
# seat (default) | full — full включает users/пароли + JWT + Yandex OAuth
# для /api/*; сид выводится из пользователя (user_<id>).
# SLC_AUTH=full
# JWT: secret ОБЯЗАТЕЛЬНО сменить в production (HS256; access 30м, refresh 7д)
# JWT_SECRET_KEY=change-me-in-production
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# true = регистрация только для admins (как легаси AUTH_ENABLED)
# AUTH_ENABLED=false
#
# Yandex OAuth (кнопка «Войти через Яндекс» на Login):
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# Allowlist env-фолбэк (если нет правил oauth_access_rules в Admin):
# YANDEX_ALLOWED_USERS=
# YANDEX_ALLOWED_GROUPS=
# YANDEX_ORG_ID=
# Yandex 360 Directory (правила ya360_org / ya360_group):
# YANDEX_360_ADMIN_TOKEN=
# YANDEX_360_ORG_ID=

# ── роли сидов ─────────────────────────────────────────────────────────────
# seat=role через запятую. Роль operator: сид может активировать/деактивировать
# документы, задачи, проекты и фокусы ДРУГИХ сидов (target_seat в MCP-тулах
# activate_task/activate_document/deactivate_document/deactivate_task,
# project_set_status, focus_set_archived).
# SLC_SEAT_ROLES=boss=operator,planner=operator

# ── организация документов ────────────────────────────────────────────────
# При add_document reasoning-LLM определяет, к какому существующему проекту
# относится документ → docs/projects/<p>/<категория>/ (иначе docs/<категория>).
# false/0 — отключает (документы всегда в категорийных папках).
SLC_AI_ORGANIZE=true

# ── контекст ──────────────────────────────────────────────────────────────
# Бюджет update_context (ТОКЕНЫ; ~3 символа на токен): кап для автолимита
# клиента (80% окна модели) и дефолт, когда клиент не рекламирует окно.
# /limit N — per-seat override (тоже токены).
SLC_CONTEXT_LIMIT_TOKENS=100000

# ── Mongo (только для бэкенда --mongodb; при Obsidian-хранилище не нужен) ─
# SLC_MONGODB_URI=mongodb://localhost:27017/slc
