# SLC MCP — deployment settings (copy for deploy: cp .env.example .env;
# .env is not committed). Used both by the container (env_file) and the CLI.

# ── Inference ─────────────────────────────────────────────────────────────
# Production serve uses MCP sampling: reasoning requests are returned to the
# authenticated seat's connected MCP client as sampling/createMessage.  SLC
# therefore needs no dedicated generative endpoint or model.  Search remains
# available through BM25 and the agent can perform iterative/agentic retrieval
# by calling the search/read tools repeatedly.
SLC_MCP_SAMPLING=true
# Fail closed to the deterministic local hash provider for CLI commands that
# run without an MCP client (for example, a non-AI migration).
SLC_LLM=hash

# Optional dedicated providers for standalone deployments.  Do not enable
# these together with SLC_MCP_SAMPLING in the development swarm.
# LMSTUDIO_URL=http://host.docker.internal:1234
# LMSTUDIO_MODEL=<reasoning-model-id>
# LMSTUDIO_EMBED_MODEL=<embedding-model-id>
# OLLAMA_ENDPOINT=http://host.docker.internal:11434
# OLLAMA_REASONING_MODEL=gemma3:latest
# OLLAMA_EMBEDDING_MODEL=bge-m3

# ── storage (Obsidian vault — DEFAULT) ────────────────────────────────────
# Vault path on the host (for the CLI; docker-compose.yml forces /data/vault
# inside the container — a volume from this folder).
SLC_VAULT_PATH=~/Obsidian/slc-vault
# Host bind path used by Docker Compose.
SLC_VAULT_HOST_PATH=~/Obsidian/slc-vault
# Commit the vault to git after every write (the vault must be a repository;
# deploy.sh up runs git init automatically):
OBSIDIAN_AUTO_GIT_COMMIT=true
# OBSIDIAN_GIT_AUTHOR="slc-mcp <slc-mcp@local>"
# Read-only known_hosts mounts cannot be rewritten by OpenSSH. This also
# guarantees that only the dedicated Forgejo deploy key is offered.
GIT_SSH_COMMAND=ssh -o UpdateHostKeys=no -o IdentitiesOnly=yes

# ── auth and seats ────────────────────────────────────────────────────────
# legacy_seat_id (legacy default) | bearer_plus_seat | embedded — auth for
# MCP endpoints (/mcp, /sse, /messages)
SLC_MCP_AUTH=legacy_seat_id
# 0 = seats never expire (imported legacy seats are not lost)
SLC_SEAT_TTL_SECONDS=0

# ── web UI authorization (full port of the legacy stack) ──────────────────
# seat (default) | full — full enables users/passwords + JWT + Yandex OAuth
# for /api/*; the seat is derived from the user (user_<id>).
# SLC_AUTH=full
# JWT: the secret MUST be changed in production (HS256; access 30m, refresh 7d)
# JWT_SECRET_KEY=change-me-in-production
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# true = registration is admin-only (legacy AUTH_ENABLED)
# AUTH_ENABLED=false
#
# Yandex OAuth (the "Sign in with Yandex" button on Login):
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# Env allowlist fallback (used when there are no oauth_access_rules in Admin):
# YANDEX_ALLOWED_USERS=
# YANDEX_ALLOWED_GROUPS=
# YANDEX_ORG_ID=
# Yandex 360 Directory (ya360_org / ya360_group rules):
# YANDEX_360_ADMIN_TOKEN=
# YANDEX_360_ORG_ID=

# ── seat roles ─────────────────────────────────────────────────────────────
# seat=role, comma-separated. The operator role enables cross-seat operations
# but by itself grants no target.
# SLC_SEAT_ROLES=boss=operator,planner=operator
# actor=target_a|target_b, comma-separated; `*` is a deliberate global grant.
# Only operator + an explicit target allows activating/deactivating documents,
# tasks, projects and focuses of OTHER seats (target_seat in MCP tools
# activate_task/activate_document/deactivate_document/deactivate_task,
# project_set_status, focus_set_archived).
# SLC_SEAT_MANAGE_ACL=boss=developer|designer,planner=developer

# Migration keeps legacy ids by default. Enable AI rename deliberately: it
# changes external document/task/project identifiers.
SLC_MIGRATE_RENAME_WITH_AI=false

# ── document organization ──────────────────────────────────────────────────
# On add_document the reasoning LLM decides which existing project the
# document belongs to → docs/projects/<p>/<category>/ (otherwise
# docs/<category>). false/0 disables (documents always go to category
# folders).
SLC_AI_ORGANIZE=true

# ── context ──────────────────────────────────────────────────────────────
# Default update_context budget (TOKENS; ~3 chars per token). This is not a
# cap: clients set their own limit via X-SLC-Context-Token-Limit or the
# /limit N command for a seat.
SLC_CONTEXT_LIMIT_TOKENS=100000

# ── MCP response pagination ────────────────────────────────────────────────
# Enables server-side pagination of large list-shaped JSON responses. Page
# size and the pagination threshold are the same value in approximate tokens
# (page ≈ tokens×3 chars; default 5000 fits a 50 KB output budget). A client
# can override both for its own connection with the X-SLC-Pagination and
# X-SLC-Page-Token-Limit headers.
SLC_PAGINATION_ENABLED=true
SLC_PAGE_TOKEN_LIMIT=5000

# ── Mongo (only for the --mongodb backend; not needed with the Obsidian
# vault) ────────────────────────────────────────────────────────────────────
# SLC_MONGODB_URI=mongodb://localhost:27017/slc_mcp
